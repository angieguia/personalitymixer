# Copy this file to spotipy.env and fill in your own values.
# spotipy.env is listed in .gitignore, so it will not be uploaded to GitHub.
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Optional: any long random string (keeps login sessions stable between restarts)
FLASK_SECRET_KEY=
